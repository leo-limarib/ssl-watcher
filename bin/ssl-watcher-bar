#!/usr/bin/env bash
# Emit bar-module JSON: a single lock icon whose class reflects the worst site
# status (ok / warn / critical), plus a tooltip listing every site.
#
#   --plain   tooltip without pango markup, for bars that render it as plain
#             text (the Omarchy shell Qt tooltip). Waybar wants the default.

set -uo pipefail

STATE_FILE="${XDG_STATE_HOME:-$HOME/.local/state}/ssl-watcher/state.json"
WARN_DAYS="${SSL_WATCHER_WARN_DAYS:-14}"
# U+F233 (nerd-font server rack), built with printf so the glyph is never a raw
# multibyte literal in this file.
ICON="${SSL_WATCHER_ICON:-$(printf '\uf233')}"
COLOR_OK="${SSL_WATCHER_COLOR_OK:-#a6e3a1}"
COLOR_WARN="${SSL_WATCHER_COLOR_WARN:-#f9e2af}"
COLOR_CRIT="${SSL_WATCHER_COLOR_CRIT:-#f38ba8}"
COLOR_UNKNOWN="${SSL_WATCHER_COLOR_UNKNOWN:-#6c7086}"

MARKUP=1
for arg in "$@"; do
  case "$arg" in
    --plain) MARKUP=0 ;;
    --help|-h)
      echo "Usage: ssl-watcher-bar [--plain]"
      exit 0
      ;;
  esac
done

if [[ ! -f "$STATE_FILE" ]]; then
  jq -nc --arg i "$ICON" \
    --arg t "SSL watcher: no data yet — run ssl-watcher-check --force" \
    '{text:$i, tooltip:$t, class:"empty"}'
  exit 0
fi

jq -c \
  --argjson warn "$WARN_DAYS" \
  --argjson markup "$MARKUP" \
  --arg icon "$ICON" \
  --arg ok "$COLOR_OK" \
  --arg warnc "$COLOR_WARN" \
  --arg crit "$COLOR_CRIT" \
  --arg unk "$COLOR_UNKNOWN" '
  # Per-site status: "crit" (expired or unreachable), "warn" (expiring soon),
  # "unknown" (no data), "ok".
  def status(s):
    if s.error != null then "crit"
    elif s.days == null then "unknown"
    elif s.days < 0 then "crit"
    elif s.days < $warn then "warn"
    else "ok" end;

  def marker(st):
    if st == "crit" then {glyph:"✗", color:$crit}
    elif st == "warn" then {glyph:"!", color:$warnc}
    elif st == "unknown" then {glyph:"?", color:$unk}
    else {glyph:"✓", color:$ok} end;

  # Escape for pango only when markup is actually being emitted; a plain
  # tooltip must show a literal ampersand, not the entity.
  def esc: if $markup == 1 then @html else . end;

  def line(s):
    status(s) as $st |
    marker($st) as $m |
    ((s.label // s.host) | esc) as $lbl |
    (if $markup == 1
     then "<span color=\"\($m.color)\">\($m.glyph)</span>"
     else $m.glyph end) + "  \($lbl) — " +
    (if $st == "crit" and s.error != null then (s.error | esc)
     elif $st == "unknown" then "unknown"
     elif s.days < 0 then "EXPIRED \(-s.days)d ago"
     else "\(s.days)d left (\(s.expires | esc))" end);

  def header:
    ((.last_check // 0) as $t |
     if $t == 0 then "SSL expiry — last check: never"
     else "SSL expiry — last check: " + ($t | localtime | strftime("%Y-%m-%d %H:%M")) end);

  if (.sites | length) == 0 then
    {text:$icon, tooltip:(header + "\n(no sites configured)"), class:"empty"}
  else
    ([.sites[] | status(.)]) as $sts |
    (if any($sts[]; . == "crit" or . == "unknown") then "critical"
     elif any($sts[]; . == "warn") then "warn"
     else "ok" end) as $cls |
    {
      text:    $icon,
      tooltip: (header + "\n" + ([.sites[] | line(.)] | join("\n"))),
      class:   $cls
    }
  end
' "$STATE_FILE"
